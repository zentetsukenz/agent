{"nodes": [{"id": "vision", "label": "loom \u2014 Vision", "file_type": "document", "source_file": "VISION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "vision_in_one_sentence", "label": "In one sentence", "file_type": "concept", "source_file": "VISION.md", "source_location": "VISION.md#in-one-sentence", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "loom turns **written practice into working agents** \u2014 one ordered lifecycle per engineering discipline, compiled by an adapter onto whatever harness a project already runs."}, {"id": "vision_the_problem", "label": "The problem", "file_type": "concept", "source_file": "VISION.md", "source_location": "VISION.md#the-problem", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Agents do not fail for lack of intelligence. They fail for lack of **context** \u2014 starting a run without knowing what the project decided, what its words mean, or what good looks like here. The knowledge exists; it is scattered across tribal memory, stale READMEs, and closed pull requests, in no form an agent can pick up."}, {"id": "vision_the_answer", "label": "The answer", "file_type": "concept", "source_file": "VISION.md", "source_location": "VISION.md#the-answer", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Write the practice **once, in prose, for a machine to interpret**. Keep it harness-agnostic. Let an [adapter](CONTEXT.md#adapter) compile it into whatever a given [harness](CONTEXT.md#harness) needs."}, {"id": "vision_where_this_is_going", "label": "Where this is going", "file_type": "concept", "source_file": "VISION.md", "source_location": "VISION.md#where-this-is-going", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "loom began as one discipline \u2014 software development. It is becoming a framework for **several**, each with its own lifecycle, vocabulary and governance, each compiled onto the harness that suits it:"}, {"id": "vision_reading_this_repository", "label": "Reading this repository", "file_type": "concept", "source_file": "VISION.md", "source_location": "VISION.md#reading-this-repository", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "| Document | For | |---|---| | [CONSTITUTION.md](CONSTITUTION.md) | The entities loom is built from, how they compose, and the rules binding them | | [CONTEXT.md](CONTEXT.md) | Every term loom uses, and pointers to every decision it has made | | [SPEC.md](SPEC.md) | Conformance rules for individual files | | [SETUP.md](SETUP.md) | Installing loom into a project | | [AGENTS.md](AGENTS.md) | How an agent bootstraps context before doing work here |"}], "edges": [{"source": "vision", "target": "context", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "VISION.md", "source_location": "VISION.md#adapter", "weight": 1.0}, {"source": "vision", "target": "workflows_sdlc_index", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "VISION.md", "source_location": "VISION.md", "weight": 1.0}, {"source": "vision", "target": "workflows_macro_pm_index", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "VISION.md", "source_location": "VISION.md", "weight": 1.0}, {"source": "vision", "target": "constitution", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "VISION.md", "source_location": "VISION.md", "weight": 1.0}, {"source": "vision", "target": "spec", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "VISION.md", "source_location": "VISION.md", "weight": 1.0}, {"source": "vision", "target": "setup", "relation": "references", "confidence": "EXTRACTED", "confidence