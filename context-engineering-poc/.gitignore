###############################################################################
# VS Code Extension (TypeScript) — .gitignore
# Based on Microsoft extension samples and VS Code ecosystem best practices
###############################################################################

# --- Build outputs (extension + tests) ---
# Compiled JavaScript and source maps from TypeScript compilation
out/
dist/

# Packaged extension file
*.vsix

# --- VS Code extension test infrastructure ---
# Downloaded VS Code builds used by @vscode/test-electron for integration tests
# This can be several hundred MB and should never be committed
.vscode-test/
.vscode-test.mjs

# --- Node.js dependencies ---
node_modules/

# --- Node.js package manager lock files (optional - your team's choice) ---
# Uncomment if you want to ignore lock files (not recommended for extensions)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# --- Node.js logs / debug outputs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Node.js caches (local, machine-specific) ---
.npm/
.node_repl_history

# --- TypeScript incremental / build metadata ---
*.tsbuildinfo

# --- VS Code / tooling temp artifacts ---
# Visual Studio / MS tooling folder occasionally created by some environments
.vs/

# LSIF / code-indexing artifacts sometimes generated by tooling/CI
tsconfig.lsif.json
*.lsif
*.db

# --- OS-specific files ---
.DS_Store
Thumbs.db
*.swp
*~

# --- IDE-specific (optional) ---
# We intentionally DO NOT ignore .vscode/ as it contains launch configs and tasks
# that are part of the extension development workflow
.idea/
*.iml

# --- Environment variables (if you use .env files) ---
.env
.env.local
.env.*.local

###############################################################################
# Note: .vscodeignore is a separate file that controls what gets packaged
# into the .vsix extension file - don't confuse the two!
###############################################################################
