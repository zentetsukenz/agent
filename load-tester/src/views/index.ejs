<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> - Load Tester</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <header>
      <nav>
        <div class="container">
          <h1><a href="/">Load Tester</a></h1>
        </div>
      </nav>
    </header>

    <main class="container">
      <% if (messages.success && messages.success.length > 0) { %>
      <div class="alert alert-success"><%= messages.success[0] %></div>
      <% } %> <% if (messages.error && messages.error.length > 0) { %>
      <div class="alert alert-error"><%= messages.error[0] %></div>
      <% } %>

      <div class="header-actions">
        <h2><%= title %></h2>
        <a href="/endpoints/new" class="btn btn-primary">+ Add Endpoint</a>
      </div>

      <% if (endpoints.length === 0) { %>
      <div class="empty-state">
        <p>No endpoints configured yet.</p>
        <p>
          <a href="/endpoints/new">Add your first endpoint</a> to get started.
        </p>
      </div>
      <% } else { %>
      <div class="endpoints-grid">
        <% endpoints.forEach(endpoint => { %>
        <div class="endpoint-card">
          <div class="endpoint-header">
            <h3><%= endpoint.name %></h3>
            <span
              class="method-badge method-<%= endpoint.method.toLowerCase() %>"
            >
              <%= endpoint.method %>
            </span>
          </div>

          <div class="endpoint-body">
            <p class="url"><%= endpoint.url %></p>

            <% if (endpoint.tests && endpoint.tests.length > 0) { %>
            <div class="last-test">
              <small>
                Last test: <%= endpoint.tests[0].status %> - <%= new
                Date(endpoint.tests[0].createdAt).toLocaleString() %>
              </small>
            </div>
            <% } %>
          </div>

          <div class="endpoint-actions">
            <a href="/endpoints/<%= endpoint.id %>/test" class="btn btn-primary"
              >Test</a
            >
            <a
              href="/endpoints/<%= endpoint.id %>/edit"
              class="btn btn-secondary"
              >Edit</a
            >
            <form
              method="POST"
              action="/endpoints/<%= endpoint.id %>?_method=DELETE"
              style="display: inline"
            >
              <button
                type="submit"
                class="btn btn-danger"
                onclick="return confirm('Are you sure?')"
              >
                Delete
              </button>
            </form>
          </div>
        </div>
        <% }); %>
      </div>
      <% } %>
    </main>

    <footer>
      <div class="container">
        <p>&copy; 2024 Load Tester. Built with Express.js</p>
      </div>
    </footer>
  </body>
</html>
