<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> - Load Tester</title>
    <link rel="stylesheet" href="/css/style.css" />
    <% if (test.status !== 'completed' && test.status !== 'failed') { %>
    <meta http-equiv="refresh" content="5" />
    <% } %>
  </head>
  <body>
    <header>
      <nav>
        <div class="container">
          <h1><a href="/">Load Tester</a></h1>
        </div>
      </nav>
    </header>

    <main class="container">
      <h2><%= title %></h2>

      <div class="endpoint-info">
        <h3><%= test.endpoint.name %></h3>
        <p><strong>URL:</strong> <%= test.endpoint.url %></p>
        <p>
          <strong>Method:</strong>
          <span
            class="method-badge method-<%= test.endpoint.method.toLowerCase() %>"
            ><%= test.endpoint.method %></span
          >
        </p>
      </div>

      <div class="test-config">
        <h4>Test Configuration</h4>
        <p><strong>Duration:</strong> <%= test.duration %> seconds</p>
        <p><strong>Connections:</strong> <%= test.connections %></p>
        <% if (test.rps) { %>
        <p><strong>Target RPS:</strong> <%= test.rps %></p>
        <% } %>
        <p>
          <strong>Status:</strong>
          <span class="status-badge status-<%= test.status %>"
            ><%= test.status %></span
          >
        </p>
        <p>
          <strong>Started:</strong> <%= new
          Date(test.createdAt).toLocaleString() %>
        </p>
        <% if (test.completedAt) { %>
        <p>
          <strong>Completed:</strong> <%= new
          Date(test.completedAt).toLocaleString() %>
        </p>
        <% } %>
      </div>

      <% if (test.status === 'pending' || test.status === 'running') { %>
      <div class="alert alert-info">
        <p>
          Test is <%= test.status %>... This page will auto-refresh every 5
          seconds.
        </p>
      </div>
      <% } %> <% if (test.status === 'failed') { %>
      <div class="alert alert-error">
        <p>Test failed. Please check the configuration and try again.</p>
        <% if (results && results.error) { %>
        <p><strong>Error:</strong> <%= results.error %></p>
        <% } %>
      </div>
      <% } %> <% if (test.status === 'completed' && results) { %>
      <div class="results">
        <h4>Test Results</h4>

        <div class="results-summary">
          <div class="result-card">
            <h5>Requests</h5>
            <p class="result-value">
              <%= results.requests.total.toLocaleString() %>
            </p>
            <p class="result-label">Total</p>
          </div>

          <div class="result-card">
            <h5>Average RPS</h5>
            <p class="result-value">
              <%= results.requests.average.toFixed(2) %>
            </p>
            <p class="result-label">req/sec</p>
          </div>

          <div class="result-card">
            <h5>Success Rate</h5>
            <p
              class="result-value <%= results.successRate >= 95 ? 'success' : 'warning' %>"
            >
              <%= results.successRate %>%
            </p>
            <p class="result-label"><%= results.errors %> errors</p>
          </div>

          <div class="result-card">
            <h5>Duration</h5>
            <p class="result-value">
              <%= (results.duration / 1000).toFixed(2) %>s
            </p>
            <p class="result-label">Actual</p>
          </div>
        </div>

        <div class="results-details">
          <h5>Latency Statistics (ms)</h5>
          <table>
            <tr>
              <th>Metric</th>
              <th>Value</th>
            </tr>
            <tr>
              <td>Minimum</td>
              <td><%= results.latency.min.toFixed(2) %> ms</td>
            </tr>
            <tr>
              <td>Mean</td>
              <td><%= results.latency.mean.toFixed(2) %> ms</td>
            </tr>
            <tr>
              <td>Maximum</td>
              <td><%= results.latency.max.toFixed(2) %> ms</td>
            </tr>
            <tr>
              <td>50th Percentile (p50)</td>
              <td><%= results.latency.p50.toFixed(2) %> ms</td>
            </tr>
            <tr>
              <td>90th Percentile (p90)</td>
              <td><%= results.latency.p90.toFixed(2) %> ms</td>
            </tr>
            <tr>
              <td>95th Percentile (p95)</td>
              <td><%= results.latency.p95.toFixed(2) %> ms</td>
            </tr>
            <tr>
              <td>99th Percentile (p99)</td>
              <td><%= results.latency.p99.toFixed(2) %> ms</td>
            </tr>
          </table>
        </div>

        <div class="results-details">
          <h5>Additional Metrics</h5>
          <table>
            <tr>
              <th>Metric</th>
              <th>Value</th>
            </tr>
            <tr>
              <td>Errors</td>
              <td><%= results.errors %></td>
            </tr>
            <tr>
              <td>Timeouts</td>
              <td><%= results.timeouts %></td>
            </tr>
            <tr>
              <td>Average Throughput</td>
              <td>
                <%= (results.throughput.average / 1024).toFixed(2) %> KB/s
              </td>
            </tr>
            <tr>
              <td>Total Data Transferred</td>
              <td>
                <%= (results.throughput.total / 1024 / 1024).toFixed(2) %> MB
              </td>
            </tr>
          </table>
        </div>
      </div>
      <% } %>

      <div class="form-actions">
        <a
          href="/endpoints/<%= test.endpoint.id %>/test"
          class="btn btn-primary"
          >Run Another Test</a
        >
        <a href="/" class="btn btn-secondary">Back to Home</a>
      </div>
    </main>

    <footer>
      <div class="container">
        <p>&copy; 2024 Load Tester. Built with Express.js</p>
      </div>
    </footer>
  </body>
</html>
