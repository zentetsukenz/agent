<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> - Load Tester</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <header>
      <nav>
        <div class="container">
          <h1><a href="/">Load Tester</a></h1>
        </div>
      </nav>
    </header>

    <main class="container">
      <h2><%= title %></h2>

      <div class="endpoint-info">
        <h3><%= endpoint.name %></h3>
        <p><strong>URL:</strong> <%= endpoint.url %></p>
        <p>
          <strong>Method:</strong>
          <span class="method-badge method-<%= endpoint.method.toLowerCase() %>"
            ><%= endpoint.method %></span
          >
        </p>
      </div>

      <% if (errors.length > 0) { %>
      <div class="alert alert-error">
        <ul>
          <% errors.forEach(error => { %>
          <li><%= error %></li>
          <% }); %>
        </ul>
      </div>
      <% } %>

      <form
        method="POST"
        action="/endpoints/<%= endpoint.id %>/test"
        class="form"
      >
        <div class="form-group">
          <label for="duration">Duration (seconds) *</label>
          <input
            type="number"
            id="duration"
            name="duration"
            value="<%= config.duration || 30 %>"
            min="1"
            max="300"
            required
          />
          <small>Test duration in seconds (1-300)</small>
        </div>

        <div class="form-group">
          <label for="connections">Concurrent Connections *</label>
          <input
            type="number"
            id="connections"
            name="connections"
            value="<%= config.connections || 10 %>"
            min="1"
            max="1000"
            required
          />
          <small>Number of concurrent connections (1-1000)</small>
        </div>

        <div class="form-group">
          <label for="rps">Requests Per Second (optional)</label>
          <input
            type="number"
            id="rps"
            name="rps"
            value="<%= config.rps || '' %>"
            min="1"
            max="100000"
          />
          <small
            >Target requests per second (1-100000). Leave empty for
            unlimited.</small
          >
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Start Load Test</button>
          <a href="/" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    </main>

    <footer>
      <div class="container">
        <p>&copy; 2024 Load Tester. Built with Express.js</p>
      </div>
    </footer>
  </body>
</html>
