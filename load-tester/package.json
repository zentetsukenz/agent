{
  "name": "load-tester-monorepo",
  "version": "2.0.0",
  "description": "Load Tester Application - Monorepo with separated frontend and backend",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "backend": "npm run dev --workspace=load-tester-backend",
    "backend:start": "npm start --workspace=load-tester-backend",
    "backend:test": "npm test --workspace=load-tester-backend",
    "backend:test:unit": "npm run test:unit --workspace=load-tester-backend",
    "backend:test:integration": "npm run test:integration --workspace=load-tester-backend",
    "frontend": "npm run dev --workspace=load-tester-frontend",
    "frontend:build": "npm run build --workspace=load-tester-frontend",
    "frontend:test": "npm test --workspace=load-tester-frontend",
    "frontend:preview": "npm run preview --workspace=load-tester-frontend",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run backend\" \"npm run frontend\"",
    "install:all": "npm install && npm install --workspaces",
    "test:all": "npm run backend:test && npm run frontend:test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "load-testing",
    "monorepo",
    "rest-api",
    "performance"
  ],
  "author": "",
  "license": "MIT"
}
