# loom:setup-hermes — {{ROLE_NAME}} profile config (Hermes)
# Generated by loom's Hermes setup. Reconcile keys individually on `update`; do not hand-append.
# See adapters/hermes/references/write-format.md for placeholder sources.

model:
  default: "{{ROLE_MODEL}}"                 # provider/model — archetype-matched, confirmed vs the user's providers
  fallback_providers:
    - provider: {{ROLE_FALLBACK_PROVIDER}}  # a fallback so a deprecation doesn't break the role
      model: {{ROLE_FALLBACK_MODEL}}

# Capability set — the role's granted toolsets (adapters/hermes/references/capabilities.md).
# What is NOT listed is as load-bearing as what is.
toolsets:
{{ROLE_TOOLSETS}}

# Load-bearing withhold: disable individual tools even though their toolset is granted.
# For read-only roles this disables write_file + patch (keeps read_file/search_files via `file`).
# The exact key is Hermes-version-specific — CONFIRM against the user's config before writing.
{{ROLE_DISABLED_TOOLS}}

terminal:
  cwd: "{{ROLE_CWD}}"                        # absolute project path, or omit to use the launch dir
